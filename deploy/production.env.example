STUDIO_DATA_DIR=/var/lib/avatar-sticker-studio
STUDIO_ALLOWED_HOSTS=sticker.coreages.com,127.0.0.1,localhost
STUDIO_ALLOWED_ORIGINS=https://sticker.coreages.com
STUDIO_SECURE_COOKIE=1
STUDIO_ALLOW_SETUP=0
STUDIO_FONT=/usr/share/fonts/opentype/noto/NotoSansCJK-Bold.ttc

# 可选：独立 ADMIN scope 密钥用于超管查询余额；留空时使用后台保存值。
# 不替换生图 FAL_KEY，密钥仅填写在服务器私密文件或后台密码框。
# FAL_ADMIN_KEY=

# 阿奇索电商业务应用；开通前留空，所有店铺默认停用。
STUDIO_AGISO_APP_ID=
STUDIO_AGISO_APP_SECRET=
STUDIO_AGISO_ENCRYPTION_KEY=
STUDIO_AGISO_PUBLIC_URL=https://sticker.coreages.com
STUDIO_AGISO_AFTERSALES_VERIFIED=0
