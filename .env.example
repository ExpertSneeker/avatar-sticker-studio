# 可复制为 .env。API Key 推荐直接在网站「管理设置」中填写。
# 此文件由 npm start / npm run dev 读取；直接运行 uvicorn 时请自行设置环境变量。
STUDIO_PORT=8000
# STUDIO_DATA_DIR=/absolute/path/to/private-studio-data
# STUDIO_FONT=/absolute/path/to/chinese-font.ttc
# FAL_KEY=
# YEZI_API_KEY=

# 拼多多 / 阿奇索。保持为空时不会连接店铺或处理订单。
# 应用密钥和加密密钥只保存在服务器私密环境文件，勿提交到 Git。
STUDIO_AGISO_APP_ID=
STUDIO_AGISO_APP_SECRET=
STUDIO_AGISO_ENCRYPTION_KEY=
STUDIO_AGISO_PUBLIC_URL=
# 仅在真实售后回调验收通过后设为 1。
STUDIO_AGISO_AFTERSALES_VERIFIED=0
